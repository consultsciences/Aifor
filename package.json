{
  "name": "clinical-dojo",
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "migrate": "node migrate.mjs",
    "generate": "node gen-ledger.mjs",
