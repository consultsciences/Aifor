# Environment configuration for clinical-dojo
# Copy this file and set secrets / connection strings; never commit the copy with real values.

# Server
APP_PORT=4319
HOST=0.0.0.0
NODE_ENV=production

# PostgreSQL (provided by Dokploy / Hostinger; adjust to your Dokploy service name)
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=clinical
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/clinical

# Optional: external orchestration endpoints (Feynman / K-Dense) — fill when wired
# FEYNMAN_API_KEY=
# K_DENSE_ENDPOINT=
