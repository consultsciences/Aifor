# Environment configuration for clinical-dojo
# Copy to .env and fill in; never commit the copy with real values.

# Server
APP_PORT=4319
PORT=4319
HOST=0.0.0.0
NODE_ENV=production

# Where fixture-mode registrations are written (must be writable by the app user)
DATA_DIR=./data

# PostgreSQL. Either set DATABASE_URL, or set the DB_* parts and the app builds
# the connection string from them (password percent-encoded). If a database is
# configured the app requires it: a failed connection exits instead of serving
# synthetic fixtures on a live URL. DB_PASSWORD has no default - set a real one;
# do not ship postgres/postgres.
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=clinical
DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres:5432/clinical

# Opt back into the old behaviour: serve fixtures when the database is down.
# Leave unset in production.
# ALLOW_FIXTURE_FALLBACK=1

# Optional: external orchestration endpoints (Feynman / K-Dense) - fill when wired
# FEYNMAN_API_KEY=
# K_DENSE_ENDPOINT=
